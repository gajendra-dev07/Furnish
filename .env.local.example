# ─── Supabase ──────────────────────────────────────────────────
# Find these in: Supabase Dashboard → Project Settings → API

# Safe to expose to the browser (used in client-side Supabase calls)
NEXT_PUBLIC_SUPABASE_URL=https://lhsrhyvaqfxchvgevtpq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# NEVER expose this. Server-only. Used in admin API routes to bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ─── Razorpay ──────────────────────────────────────────────────
# Find these in: Razorpay Dashboard → Settings → API Keys

# Safe to expose (used to open the Razorpay checkout modal in the browser)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# NEVER expose this. Server-only. Used to create & verify orders.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# ─── Resend (Email) ────────────────────────────────────────────
# Find these in: resend.com → API Keys

# NEVER expose this. Server-only.
RESEND_API_KEY=re_xxxxxxxxxxxx

# The "From" address for order emails. Must match your verified Resend domain.
RESEND_FROM_EMAIL=orders@yourdomain.com

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
